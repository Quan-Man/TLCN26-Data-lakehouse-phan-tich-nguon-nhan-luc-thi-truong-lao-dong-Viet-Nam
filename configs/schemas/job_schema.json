{
  "config_version": "1.0.0",
  "dataset": "jobs",
  "language": "vi",
  "schema_format": "Spark StructType JSON nằm tại tables[table_name].spark_schema",
  "scope": "Source -> Bronze -> Silver",
  "timezone": {
    "source_default": "Asia/Ho_Chi_Minh",
    "storage": "UTC"
  },
  "tables": {
    "source.raw_job": {
      "grain": "Một object trong mảng JSON nguồn.",
      "spark_schema": {
        "type": "struct",
        "fields": [
          {
            "name": "category",
            "type": "string",
            "nullable": true
          },
          {
            "name": "job_id",
